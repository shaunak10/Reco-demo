@page
@model LoginModel
@{
    ViewData["Title"] = "Sign in";
}
<div class="login-wrap">
    <section class="login-card" aria-labelledby="login-heading">
        <div class="brand brand-lg"><span class="brand-mark" aria-hidden="true">R</span><span>ReconAI</span></div>
        <h1 id="login-heading" class="login-title">Sign in</h1>
        <p class="lead">AI-assisted three-way settlement reconciliation: ledger, gateway and bank.</p>

        <form method="post" novalidate>
            <input type="hidden" asp-for="ReturnUrl" />
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-bad" role="alert">
                    @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@e.ErrorMessage</div>
                    }
                </div>
            }
            <div class="field">
                <label asp-for="Input.Email">Email</label>
                <input asp-for="Input.Email" autocomplete="username" inputmode="email" autofocus />
            </div>
            <div class="field">
                <label asp-for="Input.Password">Password</label>
                <input asp-for="Input.Password" autocomplete="current-password" />
            </div>
            <button type="submit" class="btn btn-primary btn-block">Sign in</button>
        </form>

        @if (Model.QuickLogin)
        {
            <div class="divider"><span>demo shortcuts</span></div>
            <form method="post" asp-page-handler="Demo" class="demo-actions">
                <input type="hidden" asp-for="ReturnUrl" />
                <button type="submit" name="role" value="Operator" class="btn btn-secondary">Sign in as Operator</button>
                <button type="submit" name="role" value="CompanyAdmin" class="btn btn-secondary">Sign in as Company Admin</button>
            </form>
            <p class="fineprint">Shortcuts exist only in the Development environment. Demo accounts are defined in <code>appsettings.Development.json</code>.</p>
        }
        <p class="fineprint">Synthetic data only. This prototype has no RBI approval, bank certification or production status.</p>
    </section>
</div>
