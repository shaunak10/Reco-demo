@page
@model ErrorModel
@{
    ViewData["Title"] = "Something went wrong";
}
<div class="empty-state">
    <h2>Something went wrong</h2>
    <p>The request could not be completed. No data was changed by this error page.</p>
    @if (!string.IsNullOrEmpty(Model.RequestId))
    {
        <p class="muted small">Reference: <code>@Model.RequestId</code></p>
    }
    <p><a class="btn btn-primary" href="/">Back to start</a></p>
</div>
