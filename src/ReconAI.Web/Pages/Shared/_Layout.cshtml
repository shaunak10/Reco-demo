@{
    var signedIn = User.Identity?.IsAuthenticated == true;
    var title = ViewData["Title"] as string ?? "ReconAI";
    var isAdmin = User.IsInRole(Roles.CompanyAdmin);
    var roleLabel = isAdmin ? "Company Admin" : "Operator";
    var tenantName = User.FindFirst(AppClaims.TenantName)?.Value ?? "";
    var current = ViewContext.RouteData.Values["page"] as string;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>@title - ReconAI</title>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%234338ca'/%3E%3Cpath d='M9 22V10h7a4 4 0 010 8h-7m6 0l5 4' fill='none' stroke='white' stroke-width='2.6' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
@if (signedIn)
{
    <body class="app">
        <a class="skip-link" href="#main">Skip to main content</a>
        <div class="scrim" id="scrim" hidden></div>
        <aside class="sidebar" id="sidebar" aria-label="Sidebar">
            <div class="brand"><span class="brand-mark" aria-hidden="true">R</span><span>ReconAI</span><small class="tag">Prototype</small></div>
            <div class="tenant" title="Demo company">@tenantName</div>
            <nav aria-label="Primary">
                @foreach (var group in NavCatalog.Items.Where(i => isAdmin || !i.AdminOnly).GroupBy(i => i.Group))
                {
                    <div class="nav-group">@group.Key</div>
                    @foreach (var item in group)
                    {
                        var active = item.Page is not null && (current == item.Page || (item.ActivePrefix is not null && current is not null && current.StartsWith(item.ActivePrefix, StringComparison.Ordinal)));
                        if (item.Page is null)
                        {
                            <span class="nav-item is-disabled" aria-disabled="true" title="Built in Step @item.Step of the implementation plan">
                                <partial name="_Icon" model="item.Icon" />@item.Title<small class="step">Step @item.Step</small>
                            </span>
                        }
                        else
                        {
                            <a class="nav-item @(active ? "is-active" : "")" asp-page="@item.Page" aria-current="@(active ? "page" : null)">
                                <partial name="_Icon" model="item.Icon" />@item.Title
                            </a>
                        }
                    }
                }
            </nav>
            <div class="sidebar-foot">Synthetic data only.<br />Not a production system.</div>
        </aside>
        <div class="main-col">
            <header class="topbar">
                <button type="button" class="menu-btn" id="menuBtn" aria-controls="sidebar" aria-expanded="false" aria-label="Open navigation">
                    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16 M4 12h16 M4 17h16" /></svg>
                </button>
                <h1 class="page-title">@title</h1>
                <div class="topbar-right">
                    <span class="chip @(isAdmin ? "chip-brand" : "chip-info")">@roleLabel</span>
                    <span class="user">@User.Identity!.Name</span>
                    <form method="post" asp-page="/Account/Logout">
                        <button type="submit" class="btn btn-ghost btn-sm"><partial name="_Icon" model='"logout"' />Sign out</button>
                    </form>
                </div>
            </header>
            <main id="main" class="content">
                @RenderBody()
            </main>
        </div>
        <script src="~/js/site.js" asp-append-version="true"></script>
        @await RenderSectionAsync("Scripts", required: false)
    </body>
}
else
{
    <body class="bare">
        <main id="main">
            @RenderBody()
        </main>
        <script src="~/js/site.js" asp-append-version="true"></script>
        @await RenderSectionAsync("Scripts", required: false)
    </body>
}
</html>
